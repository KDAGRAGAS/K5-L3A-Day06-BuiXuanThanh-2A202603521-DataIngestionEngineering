# Vector store: chroma (mặc định, chạy local trên đĩa, KHÔNG cần Docker) hoặc pgvector.
VECTOR_STORE=chroma
# Chroma lưu ở results/chroma. Đổi chỗ lưu nếu muốn:
# CHROMA_DIR=results/chroma

# Chỉ dùng khi VECTOR_STORE=pgvector (cần Docker + cài psycopg): kết nối local của Docker Compose.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Embedding model: one model for all three strategies.
# local = sentence-transformers on this machine (no key, cost 0).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# e5 models need these prefixes (see the model card). Keep the quotes and the trailing space.
# For models without prefixes (e.g. paraphrase-multilingual-MiniLM-L12-v2) leave them empty.
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOC_PREFIX="passage: "
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE=cpu

# API instead of local: EMBEDDING_PROVIDER=openai_compatible
#   OpenAI:     EMBEDDING_API_BASE=https://api.openai.com/v1                              EMBEDDING_MODEL=text-embedding-3-small
#   OpenRouter: EMBEDDING_API_BASE=https://openrouter.ai/api/v1
#   Gemini:     EMBEDDING_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai  EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_PRICE_PER_1M_TOKENS=0
# EMBEDDING_DIMENSIONS=

# Optional path overrides (relative to the repo root).
# MANIFEST_PATH=data/manifest.json
# BENCHMARK_PATH=benchmark/questions.json
# RESULTS_DIR=results
